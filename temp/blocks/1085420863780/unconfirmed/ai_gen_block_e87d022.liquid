{% doc %}
  @prompt
    Create a two-product side-by-side showcase section. It should display exactly 2 products next to each other, each showing the product image, product title, price, and a clickable button or card that links directly to the product page. The layout should be clean, bold, and minimal — fitting a music artist merch store with a monochrome aesthetic. Each product should be selectable via a product picker setting so the merchant can choose which 2 products to feature. The section should be fully clickable and work well on both mobile and desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-merch-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 28px 0;
    color: {{ settings.color_palette.foreground }};
  }

  .ai-merch-showcase-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: inherit;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(24px, 4vw, 42px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .ai-merch-showcase-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 2.5vw, 28px);
    width: 100%;
  }

  .ai-merch-showcase-{{ ai_gen_id }}__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    border: 1px solid {{ settings.color_palette.foreground }};
    background: {{ settings.color_palette.background }};
  }

  .ai-merch-showcase-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid {{ settings.color_palette.foreground }};
    outline-offset: 4px;
  }

  .ai-merch-showcase-{{ ai_gen_id }}__media {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: {{ settings.color_palette.background }};
  }

  .ai-merch-showcase-{{ ai_gen_id }}__media img,
  .ai-merch-showcase-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-merch-showcase-{{ ai_gen_id }}__details {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: clamp(12px, 2vw, 20px);
  }

  .ai-merch-showcase-{{ ai_gen_id }}__title {
    margin: 0;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: clamp(14px, 2vw, 20px);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .ai-merch-showcase-{{ ai_gen_id }}__price {
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-merch-showcase-{{ ai_gen_id }}__action {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 42px;
    width: 100%;
    margin-top: auto;
    padding: 10px 12px;
    border: 1px solid {{ settings.color_palette.foreground }};
    background: {{ settings.color_palette.foreground }};
    color: {{ settings.color_palette.background }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .ai-merch-showcase-{{ ai_gen_id }}__card:hover .ai-merch-showcase-{{ ai_gen_id }}__action {
    background: {{ settings.color_palette.background }};
    color: {{ settings.color_palette.foreground }};
  }

  .ai-merch-showcase-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 24px;
    border: 1px dashed {{ settings.color_palette.foreground }};
    font-size: 14px;
    text-align: center;
  }

  @media screen and (max-width: 480px) {
    .ai-merch-showcase-{{ ai_gen_id }} {
      padding: 20px 0;
    }

    .ai-merch-showcase-{{ ai_gen_id }}__details {
      gap: 8px;
      padding: 10px;
    }

    .ai-merch-showcase-{{ ai_gen_id }}__action {
      min-height: 38px;
      padding-inline: 6px;
      font-size: 10px;
    }
  }
{% endstyle %}

<div class="ai-merch-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-merch-showcase-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-merch-showcase-{{ ai_gen_id }}__grid">
    {% assign first_product = block.settings.product_one %}
    {% assign second_product = block.settings.product_two %}
    {% if first_product != blank %}
      <a class="ai-merch-showcase-{{ ai_gen_id }}__card" href="{{ first_product.url }}" aria-label="{{ first_product.title | escape }} — view product">
        <span class="ai-merch-showcase-{{ ai_gen_id }}__media">
          {% if first_product.featured_image %}
            <img src="{{ first_product.featured_image | image_url: width: 1000 }}" alt="{{ first_product.featured_image.alt | default: first_product.title | escape }}" width="{{ first_product.featured_image.width }}" height="{{ first_product.featured_image.height }}" loading="lazy">
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          {% endif %}
        </span>
        <span class="ai-merch-showcase-{{ ai_gen_id }}__details">
          <span class="ai-merch-showcase-{{ ai_gen_id }}__title">{{ first_product.title | escape }}</span>
          <span class="ai-merch-showcase-{{ ai_gen_id }}__price">{{ first_product.price | money }}</span>
          <span class="ai-merch-showcase-{{ ai_gen_id }}__action">Shop now</span>
        </span>
      </a>
    {% endif %}

    {% if second_product != blank %}
      <a class="ai-merch-showcase-{{ ai_gen_id }}__card" href="{{ second_product.url }}" aria-label="{{ second_product.title | escape }} — view product">
        <span class="ai-merch-showcase-{{ ai_gen_id }}__media">
          {% if second_product.featured_image %}
            <img src="{{ second_product.featured_image | image_url: width: 1000 }}" alt="{{ second_product.featured_image.alt | default: second_product.title | escape }}" width="{{ second_product.featured_image.width }}" height="{{ second_product.featured_image.height }}" loading="lazy">
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          {% endif %}
        </span>
        <span class="ai-merch-showcase-{{ ai_gen_id }}__details">
          <span class="ai-merch-showcase-{{ ai_gen_id }}__title">{{ second_product.title | escape }}</span>
          <span class="ai-merch-showcase-{{ ai_gen_id }}__price">{{ second_product.price | money }}</span>
          <span class="ai-merch-showcase-{{ ai_gen_id }}__action">Shop now</span>
        </span>
      </a>
    {% endif %}

    {% if first_product == blank or second_product == blank %}
      <div class="ai-merch-showcase-{{ ai_gen_id }}__empty">Choose two products in the block settings to feature them here.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Two-product showcase",
  "settings": [
    {
      "type": "header",
      "content": "Featured products"
    },
    {
      "type": "product",
      "id": "product_one",
      "label": "First product"
    },
    {
      "type": "product",
      "id": "product_two",
      "label": "Second product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured merch"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Two-product showcase"
    }
  ],
  "tag": null,
  "class": "two-product-showcase"
}
{% endschema %}