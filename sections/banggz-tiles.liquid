{%- comment -%} Love, Banggz — store tiles (Vinyl / CD / Merch) with hover image swap, mirrors reference store row {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section
  class="section bz-tiles spacing-style"
  id="bz-tiles-{{ section.id }}"
  style="{% render 'spacing-style', settings: s %}; --bz-bg: {{ s.background_color | default: '#E9E5DC' }}; --bz-fg: {{ s.text_color | default: '#2C2C2A' }}; --bz-accent: {{ s.accent_color | default: '#D5532C' }}; --bz-muted: {{ s.muted_color | default: '#6F6B66' }};"
>
  <div class="bz-tiles__inner">
    {%- if s.heading != blank -%}
      <div class="bz-tiles__head">
        <p class="bz-eyebrow">{{ s.heading }}</p>
      </div>
    {%- endif -%}
    <div class="bz-tiles__grid" style="--bz-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="bz-tile" href="{{ b.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="bz-tile__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 92vw', class: 'bz-tile__img bz-tile__img--base' }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'bz-tile__img bz-tile__img--base' }}
            {%- endif -%}
            {%- if b.hover_image != blank -%}
              {{ b.hover_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 92vw', class: 'bz-tile__img bz-tile__img--hover' }}
            {%- endif -%}
          </div>
          <span class="bz-btn bz-btn--secondary bz-tile__cta"><span>{{ b.label }}</span></span>
        </a>
      {%- endfor -%}
    </div>
    {%- if s.cta_label != blank -%}
      <div class="bz-tiles__foot">
        <a class="bz-btn bz-btn--primary" href="{{ s.cta_link }}"><span>{{ s.cta_label }}</span></a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .bz-tiles { background: var(--bz-bg); color: var(--bz-fg); }
  .bz-tiles__inner { max-width: var(--page-width); margin-inline: auto; padding-inline: var(--page-margin, 16px); display: flex; flex-direction: column; gap: 24px; }
  .bz-tiles__grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 750px) { .bz-tiles__grid { grid-template-columns: repeat(var(--bz-cols), minmax(0, 1fr)); gap: 16px; } }
  .bz-tile { display: flex; flex-direction: column; align-items: center; gap: 14px; text-decoration: none; color: inherit; }
  .bz-tile__media { position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; background: #D8D2C8; }
  .bz-tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 400ms ease, transform 700ms cubic-bezier(.2,.8,.2,1); }
  .bz-tile__img--hover { opacity: 0; }
  .bz-tile:hover .bz-tile__img--base { transform: scale(1.04); }
  .bz-tile:hover .bz-tile__img--hover { opacity: 1; transform: scale(1.04); }
  .bz-tile:hover .bz-tile__cta, .bz-tile:focus-visible .bz-tile__cta { background: var(--bz-fg); color: var(--bz-bg); }
  .bz-tiles__foot { display: flex; justify-content: center; margin-top: 8px; }
{% endstylesheet %}

{% schema %}
{
  "name": "LB — Store tiles",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "Store" },
    { "type": "text", "id": "cta_label", "label": "Bottom button label", "default": "Shop the Love, Banggz collection" },
    { "type": "url", "id": "cta_link", "label": "Bottom button link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#E9E5DC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2C2C2A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D5532C" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6F6B66" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "hover_image", "label": "Hover image (shown on hover)" },
        { "type": "text", "id": "label", "label": "Button label", "default": "Buy merch" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "LB — Store tiles",
    "blocks": [
      { "type": "tile", "settings": { "label": "Buy vinyl" } },
      { "type": "tile", "settings": { "label": "Buy CD" } },
      { "type": "tile", "settings": { "label": "Buy merch" } }
    ]
  }]
}
{% endschema %}
