{%- comment -%} Love, Banggz — featured singles: artwork + Listen now, mirrors reference singles row {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section
  class="section bz-singles spacing-style"
  id="bz-singles-{{ section.id }}"
  style="{% render 'spacing-style', settings: s %}; --bz-bg: {{ s.background_color | default: '#E9E5DC' }}; --bz-fg: {{ s.text_color | default: '#2C2C2A' }}; --bz-accent: {{ s.accent_color | default: '#D5532C' }}; --bz-muted: {{ s.muted_color | default: '#6F6B66' }};"
>
  <div class="bz-singles__inner">
    {%- if s.heading != blank -%}<p class="bz-eyebrow">{{ s.heading }}</p>{%- endif -%}
    <div class="bz-singles__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="bz-single" {{ block.shopify_attributes }}>
          <a class="bz-single__art" href="{{ b.link | default: '#' }}" target="_blank" rel="noopener" aria-label="Listen to {{ b.title | escape }}">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 46vw, 92vw', class: 'bz-single__img' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'bz-single__img' }}
            {%- endif -%}
            <span class="bz-single__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </a>
          <h3 class="bz-single__title">{{ b.title }}</h3>
          {%- if b.subtitle != blank -%}<p class="bz-single__sub">{{ b.subtitle }}</p>{%- endif -%}
          <a class="bz-link" href="{{ b.link | default: '#' }}" target="_blank" rel="noopener">{{ b.cta | default: 'Listen now' }}</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .bz-singles { background: var(--bz-bg); color: var(--bz-fg); }
  .bz-singles__inner { max-width: var(--page-width); margin-inline: auto; padding-inline: var(--page-margin, 16px); display: flex; flex-direction: column; gap: 24px; }
  .bz-singles__grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  @media (min-width: 750px) { .bz-singles__grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .bz-single { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
  .bz-single__art { position: relative; display: block; width: 100%; max-width: 420px; aspect-ratio: 1; overflow: hidden; background: #D8D2C8; }
  .bz-single__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 700ms cubic-bezier(.2,.8,.2,1); }
  .bz-single__art:hover .bz-single__img { transform: scale(1.04); }
  .bz-single__play {
    position: absolute; left: 50%; top: 50%; width: 56px; height: 56px; margin: -28px 0 0 -28px;
    display: grid; place-items: center; border-radius: 999px; background: var(--bz-accent); color: #E9E5DC;
    opacity: 0; transform: scale(.8); transition: opacity 250ms ease, transform 250ms ease;
  }
  .bz-single__art:hover .bz-single__play, .bz-single__art:focus-visible .bz-single__play { opacity: 1; transform: scale(1); }
  .bz-single__title { margin: 12px 0 0; font-family: var(--font-heading--family); font-weight: var(--font-heading--weight); font-size: 1.25rem; letter-spacing: -.01em; text-transform: uppercase; }
  .bz-single__sub { margin: 0; font-size: 0.8125rem; color: var(--bz-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "LB — Singles",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "Focus tracks" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#E9E5DC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2C2C2A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D5532C" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6F6B66" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "single",
      "name": "Single",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artwork" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pretty & Gorgeous" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Listen now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "LB — Singles",
    "blocks": [
      { "type": "single", "settings": { "title": "Pretty & Gorgeous", "subtitle": "Lead single" } },
      { "type": "single", "settings": { "title": "BlackBerry Luv", "subtitle": "feat. Anaïs Cardot" } }
    ]
  }]
}
{% endschema %}
