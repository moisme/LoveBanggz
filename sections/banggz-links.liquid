{%- comment -%} Love, Banggz — stacked equal-width action links under the album cover. Button styles are self-contained. {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section
  class="section bz-links spacing-style"
  id="bz-links-{{ section.id }}"
  style="{% render 'spacing-style', settings: s %}; --bz-links-bg: {{ s.background_color | default: '#E9E5DC' }}; --bz-links-width: {{ s.button_width }}px;"
>
  <div class="bz-links__inner">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <a
        class="bz-btn bz-links__btn {% if b.style == 'primary' %}bz-btn--primary{% else %}bz-btn--secondary{% endif %}"
        href="{{ b.link | default: '#' }}"
        {% if b.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
        {{ block.shopify_attributes }}
      ><span>{{ b.label }}</span></a>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .bz-links { background: var(--bz-links-bg); }
  .bz-links__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .bz-links .bz-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(var(--bz-links-width, 240px), 100%);
    padding: 13px 22px;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 0;
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    transition: color 250ms cubic-bezier(.2,.8,.2,1), background-color 250ms cubic-bezier(.2,.8,.2,1), border-color 250ms cubic-bezier(.2,.8,.2,1), transform 250ms cubic-bezier(.2,.8,.2,1);
  }
  .bz-links .bz-btn > span { position: relative; z-index: 1; }
  .bz-links .bz-btn::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #2C2C2A;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 350ms cubic-bezier(.2,.8,.2,1);
    z-index: 0;
  }
  .bz-links .bz-btn:hover::after,
  .bz-links .bz-btn:focus-visible::after { transform: scaleX(1); }
  .bz-links .bz-btn:active { transform: translateY(1px); }

  .bz-links .bz-btn--primary {
    background: #D5532C;
    color: #E9E5DC;
    border-color: #D5532C;
  }
  .bz-links .bz-btn--primary:hover,
  .bz-links .bz-btn--primary:focus-visible { border-color: #2C2C2A; color: #E9E5DC; }

  .bz-links .bz-btn--secondary {
    background: transparent;
    color: #2C2C2A;
    border-color: #2C2C2A;
  }
  .bz-links .bz-btn--secondary:hover,
  .bz-links .bz-btn--secondary:focus-visible { color: #E9E5DC; border-color: #2C2C2A; }

  @media (prefers-reduced-motion: reduce) {
    .bz-links .bz-btn, .bz-links .bz-btn::after { transition: none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LB — Action links",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 4,
  "settings": [
    { "type": "range", "id": "button_width", "label": "Button width", "min": 300, "max": 1200, "step": 20, "unit": "px", "default": 500 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#E9E5DC" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Listen now" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary (orange)" },
            { "value": "secondary", "label": "Secondary (outline)" }
          ],
          "default": "primary"
        },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "LB — Action links",
    "blocks": [
      { "type": "link", "settings": { "label": "Listen now", "style": "primary" } },
      { "type": "link", "settings": { "label": "Store", "style": "secondary" } }
    ]
  }]
}
{% endschema %}
